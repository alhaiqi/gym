{
  "name": "Gym Log",
  "short_name": "Gym",
  "description": "Upper-body hypertrophy log with A/B rotation, adaptive weekly plan and exercise swaps.",
  "start_url": "./?source=app",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#1E232B",
  "theme_color": "#1E232B",
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "shortcuts": [
    {"name": "Start workout", "url": "./#today", "icons": [{"src": "icon-192.png", "sizes": "192x192"}]},
    {"name": "History", "url": "./#progress", "icons": [{"src": "icon-192.png", "sizes": "192x192"}]}
  ]
}
