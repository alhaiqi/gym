{
  "manifest_version": 3,
  "name": "Gym Log",
  "version": "1.1.0",
  "description": "Opens your Gym Log (Alt+Shift+G) and your weekly groceries list (Alt+Shift+F).",
  "action": {
    "default_title": "Open Gym Log (Alt+Shift+G). Groceries: Alt+Shift+F",
    "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}
  },
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
  "background": {"service_worker": "background.js"},
  "permissions": ["tabs"],
  "commands": {
    "_execute_action": {"suggested_key": {"default": "Alt+Shift+G"}, "description": "Open Gym Log"},
    "open-groceries": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Open the groceries list"}
  }
}
